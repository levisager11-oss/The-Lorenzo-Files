rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(dbId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/databases/$(dbId)/members/$(request.auth.uid));
    }

    // /users/{uid}: profile + currentDatabaseId.
    // Read by any signed-in user (used for displaying usernames). Each user
    // can write only their own profile.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Presence tracking: users can write their own presence doc, anyone authenticated can read
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // /databases/{dbId}: top-level metadata (name, joinCode, ownerId, etc.).
    // Any signed-in user can read so they can resolve a join code.
    // Any signed-in user can create a new database (becoming its owner).
    // Updates: owner can rename / change settings; member-count changes are
    // permitted on join/leave.
    match /databases/{dbId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isMain == false
        && request.resource.data.requiresUniversalPassword == false;
      allow update: if isSignedIn()
        && (
          // Owner can update most fields, but cannot flip isMain or requiresUniversalPassword.
          (resource.data.ownerId == request.auth.uid
            && request.resource.data.isMain == resource.data.isMain
            && request.resource.data.requiresUniversalPassword == resource.data.requiresUniversalPassword)
          // Any member can adjust memberCount (used during join/leave).
          || (isMember(dbId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']))
        );
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.isMain == false;

      // /databases/{dbId}/members/{uid}: a user's membership doc.
      match /members/{uid} {
        allow read: if isMember(dbId) || request.auth.uid == uid;
        // Joining: user creates own membership
        allow create: if isSignedIn() && request.auth.uid == uid;
        // Updates: only own doc; XP delta of +50 (uploads) or any field except XP.
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      // /databases/{dbId}/evidenceFiles/{fileId}: archived evidence, scoped per-db.
      match /evidenceFiles/{fileId} {
        allow read: if isMember(dbId);
        allow create: if isMember(dbId);
        // Disallow direct upvotes/downvotes field updates from client (must go through transaction in voteOnFile, which writes to voters/ and updates the file doc).
        allow update: if isMember(dbId);
        allow delete: if isMember(dbId)
          && resource.data.uploadedById == request.auth.uid;

        // Voters sub-collection: each user owns only their own voter doc
        match /voters/{voterUid} {
          allow read:   if isMember(dbId);
          allow write:  if isMember(dbId) && request.auth.uid == voterUid;
          allow delete: if isMember(dbId) && request.auth.uid == voterUid;
        }

        match /intelReports/{reportId} {
          allow read: if isMember(dbId);
          allow create: if isMember(dbId)
            && request.resource.data.authorId == request.auth.uid;
          allow update: if isMember(dbId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']);
          allow delete: if isMember(dbId)
            && resource.data.authorId == request.auth.uid;

          match /voters/{voterUid} {
            allow read:   if isMember(dbId);
            allow write:  if isMember(dbId) && request.auth.uid == voterUid;
            allow delete: if isMember(dbId) && request.auth.uid == voterUid;
          }
        }
      }
    }
  }
}
